# The Jev (TypeSafe System One) is reached through the `jev` Edge Function of
# the Supabase project, with the signed-in user's session. Its key lives only
# there: `supabase secrets set TYPESAFE_API_KEY=...` (see JayV-Coder/supabase).

# Worker providers currently referenced by config.yaml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

