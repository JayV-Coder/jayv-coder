{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jev Orchestrator",
  "version": "0.6.0",
  "identifier": "ai.jev.orchestrator",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npx vite --host 127.0.0.1 --port 1420", "beforeBuildCommand": "npx vite build" },
  "app": { "windows": [{ "title": "Jev Orchestrator", "width": 1180, "height": 780, "minWidth": 760, "minHeight": 560, "resizable": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}
